# Copy to .env.local and fill in whichever values you have.
# Nothing here is required — every var has a safe default. See README.md
# "Environment variables" for full details.

# Selects the active ordering engine: v1 | v2 | v3 (default: v1)
AI_ENGINE=v3

# AI Gateway failover order (default: gemini,groq,openrouter)
AI_PROVIDER_ORDER=gemini,groq,openrouter

# Optional provider keys — used by V3 via the AI Gateway. Leave blank/unset
# to skip a provider; if all are unset, V3 falls back to the deterministic
# V2 pipeline for every message.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Logging verbosity: debug | info | warn | error | silent (default: info)
LOG_LEVEL=info
